# Environment Configuration Template for TradeIT
# Mode: PAPER or LIVE (LIVE requires explicit manual authorization)
TRADING_MODE=PAPER

# Dhan Credentials (obtain from Dhan web portal -> DhanHQ API)
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# Market Data Source: DHAN_LIVE or SIMULATED
MARKET_DATA_SOURCE=SIMULATED

# Logging
LOG_LEVEL=INFO

# Risk Limits (Capital Protection)
MAX_DAILY_LOSS=5000.0
MAX_PER_TRADE_RISK=1500.0
MAX_OPEN_POSITIONS=2
MAX_CAPITAL_PER_TRADE=25000.0

# Trading Hours (IST)
MARKET_OPEN_TIME=09:15:00
MARKET_CLOSE_TIME=15:30:00
NO_NEW_ENTRY_TIME=15:00:00
AUTO_SQUARE_OFF_TIME=15:15:00
